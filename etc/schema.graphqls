type Query {
    company: Company
        @resolver(class: "Orangecat\\CompanyGraphQl\\Model\\Resolver\\Company")
        @doc(description: "Returns the B2B company assigned to the currently authenticated customer, or null if the customer does not belong to a company.")
}

type Customer {
    company: Company
        @resolver(class: "Orangecat\\CompanyGraphQl\\Model\\Resolver\\Company")
        @doc(description: "The B2B company the customer belongs to, if any.")
}

type Mutation {
    updateCompany(input: CompanyUpdateInput!): Company
        @resolver(class: "Orangecat\\CompanyGraphQl\\Model\\Resolver\\UpdateCompany")
        @doc(description: "Update the authenticated administrator's own company profile. Only provided fields change.")
    assignCompanyUser(customer_id: Int!, role_id: Int!): Company
        @resolver(class: "Orangecat\\CompanyGraphQl\\Model\\Resolver\\AssignCompanyUser")
        @doc(description: "Add an existing customer to the administrator's company, or change the role of a member. Returns the updated company.")
    removeCompanyUser(customer_id: Int!): Company
        @resolver(class: "Orangecat\\CompanyGraphQl\\Model\\Resolver\\RemoveCompanyUser")
        @doc(description: "Remove a user from the administrator's company. Returns the updated company.")
}

input CompanyUpdateInput @doc(description: "Fields that can be updated on a company. Omit a field to leave it unchanged.") {
    name: String
    legal_name: String
    email: String
    vat_tax_id: String
    address: String
    city: String
    region: String
    postcode: String
    country_code: String
    telephone: String
}

type Company @doc(description: "A B2B company account (Orangecat_Company).") {
    id: Int @doc(description: "Company entity ID.")
    name: String @doc(description: "Company name.")
    legal_name: String @doc(description: "Legal / registered company name.")
    email: String @doc(description: "Company email address.")
    vat_tax_id: String @doc(description: "Tax / VAT identifier.")
    address: String @doc(description: "Street address.")
    city: String @doc(description: "City.")
    region: String @doc(description: "State / province / region.")
    postcode: String @doc(description: "ZIP / postal code.")
    country_code: String @doc(description: "Two-letter country code.")
    telephone: String @doc(description: "Company phone number.")
    is_company_admin: Boolean @doc(description: "Whether the authenticated customer is an administrator of this company.")
    role_id: Int @doc(description: "The authenticated customer's role ID within the company.")
    users: [CompanyUser] @doc(description: "The company's members (team roster).")
        @resolver(class: "Orangecat\\CompanyGraphQl\\Model\\Resolver\\CompanyUsers")
    roles: [CompanyRole] @doc(description: "Roles that can be assigned to company members.")
        @resolver(class: "Orangecat\\CompanyGraphQl\\Model\\Resolver\\CompanyRoles")
}

type CompanyRole @doc(description: "A B2B company role.") {
    id: Int @doc(description: "Role ID (use as role_id in assignCompanyUser).")
    name: String @doc(description: "Role name.")
    permissions: String @doc(description: "Raw permissions payload (JSON) as stored by Orangecat_Company.")
    is_admin_role: Boolean @doc(description: "Whether this is the administrator role.")
}

type CompanyUser @doc(description: "A member of a B2B company.") {
    customer_id: Int @doc(description: "Customer entity ID of the member.")
    firstname: String @doc(description: "Member first name.")
    lastname: String @doc(description: "Member last name.")
    email: String @doc(description: "Member email address.")
    role_id: Int @doc(description: "The member's role ID within the company.")
    is_company_admin: Boolean @doc(description: "Whether this member is a company administrator.")
}
